# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB0.
MONGO_URI=mongodb+srv://cultureadmin:culturEE%40*77@cluster0.toedfto.mongodb.net/hostelhub?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
